OPENAI_API_KEY=
OPENAI_BASE_URL=
TAVILY_API_KEY=
BRAVE_API_KEY=
DOC_PATH=./my-docs

# Optional: different host ports when running a second stack (defaults: 8067, 3037)
# GPTR_HOST_PORT=8068
# NEXTJS_HOST_PORT=3038

# Dex-researcher: OpenRouter (use FAST_LLM=openrouter:openai/gpt-4o-mini etc.)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Dex-researcher: On-prem RAG API
RAG_API_URL=
RAG_API_KEY=

# Dex-researcher: Private mode (no external search or LLM)
PRIVATE_MODE=false

# Dex-researcher: Audit (file = JSONL to path below)
AUDIT_STORAGE=file
AUDIT_LOG_PATH=data/audit.jsonl

# NEXT_PUBLIC_GPTR_API_URL=http://0.0.0.0:8000  # Defaults to localhost:8000 if not set

# Scraper Configuration
# ---------------------
# Control concurrent scraping and rate limiting to respect API limits
# MAX_SCRAPER_WORKERS=15
# SCRAPER_RATE_LIMIT_DELAY=0.0

# LangChain Tracing (LangSmith) - Enable for enhanced observability
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT="gpt-researcher"
